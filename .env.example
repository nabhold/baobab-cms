# --- Payload core ---
PAYLOAD_SECRET=super-secret-change-me
PAYLOAD_JWT_SECRET=jwt-secret-change-me
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload
PGSSLMODE=disable

# --- Baobab platform identity (ADR-0012, ADR-0020) ---
# Identifies this deployment when it registers as a Baobab EngineInstance.
# Included on canonical events as `sourceEngineInstance` (ADR-0018 §16).
BAOBAB_ENGINE_INSTANCE_ID=local-dev

# --- Canonical events / outbox transport (ADR-0018) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
BAOBAB_EVENTS_QUEUE=baobab.canonical-events

# --- CORS / CSRF ---
CORS_ORIGIN=http://localhost:3000
CSRF_ORIGIN=http://localhost:3000

# --- Object storage for media (ADR-0016) ---
# Local development: point at the bundled MinIO service (docker-compose).
# Production: point at a real S3-compatible bucket/region/credentials.
# Leaving S3_ENDPOINT and S3_BUCKET both unset disables the storage plugin
# entirely (uploads will fail explicitly rather than silently landing on
# the container filesystem — ADR-0016 §10, §83).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=baobab-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Control Plane integration (ADR-0013, ADR-0015) ---
# No Control Plane service exists in this environment yet. When one is
# available, point the mapping resolver at it here; until then,
# src/baobab/mappings uses the documented in-memory/local-projection
# fallback (see docs/architecture/mappings.md).
# CONTROL_PLANE_URL=https://control-plane.internal.example.com
# CONTROL_PLANE_SERVICE_TOKEN=
